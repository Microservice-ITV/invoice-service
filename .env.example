NODE_ENV=development
PORT=5006
DATABASE_URL=mysql://invoice_user:invoice_password@invoice-db:3306/invoice_service
# Comma-separated list of allowed origins: the browser app and the headless
# PDF renderer (which loads the invoice print route from the frontend container).
CORS_ORIGIN=http://localhost:3000,http://frontendreact-node:5173
LOG_LEVEL=info
SERVICE_API_KEY=change-me-strong-service-key
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=order_events
RABBITMQ_PAYMENT_COMPLETED_KEY=payment.completed
MINIO_ENDPOINT=localhost
# Host-published MinIO API port (docker-compose.yml publishes 9010:9000 and
# overrides MINIO_ENDPOINT/MINIO_PORT to minio:9000 for the container).
MINIO_PORT=9010
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=invoices
MINIO_USE_SSL=false
PUBLIC_BASE_URL=http://localhost:9010

# Required (src/config/env.ts). ORDER_SERVICE_API_KEY must match order-service's
# WALLET_SERVICE_API_KEY for internal snapshot calls to be accepted.
ORDER_SERVICE_URL=http://host.docker.internal:8001
ORDER_SERVICE_BASE_URL=http://order-nginx
ORDER_SERVICE_API_KEY=a23r_sfw32wefsasfwerwe123dsafsfver

# Frontend base URL used by Puppeteer to render invoice PDFs from the shared
# invoice print route, so the PDF always matches the web invoice.
# Inside Docker (shared `itv-network`) use the frontend container name, e.g.
#   FRONTEND_BASE_URL=http://frontendreact-node:5173
# When rendering through the published nginx port instead, use e.g.
#   FRONTEND_BASE_URL=http://host.docker.internal:3000
FRONTEND_BASE_URL=http://frontendreact-node:5173

# Optional (defaults applied by src/config/env.ts). JWT_SECRET must equal the
# auth-service signing secret for protected routes to verify tokens; when it is
# unset those routes answer 503 "Invoice authentication is not configured".
# AUTH_SERVICE_URL=http://authservice-nginx:80
# AUTH_SERVICE_INTERNAL_KEY=change-me-internal-service-key
# PRODUCT_SERVICE_URL=http://product-service/api/v1
# JWT_SECRET=change-me-32-character-minimum-secret
