generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum InvoiceStatus {
  UNPAID
  PENDING_VERIFICATION
  PAID
  REJECTED
  VOID
  REFUNDED
}

enum ReceiptStatus {
  ISSUED
  VOID
  REFUNDED
}

model Invoice {
  id                 String        @id @default(uuid()) @db.Char(36)
  invoiceNumber      String        @unique @db.VarChar(50)

  // One Order can have multiple invoices
  orderId            String        @db.Char(36)
  orderReference     String?       @db.VarChar(32)

  shopId             String        @db.Char(36)
  shopName           String?       @db.VarChar(255)

  customerId         String        @db.Char(36)
  customerName       String?       @db.VarChar(255)
  customerEmail      String?       @db.VarChar(255)
  customerPhone      String?       @db.VarChar(64)
  billingAddress     Json?
  shippingAddress    Json?

  shopContactName    String?       @db.VarChar(255)
  shopContactEmail   String?       @db.VarChar(255)
  shopContactPhone   String?       @db.VarChar(64)
  shopAddress        String?       @db.Text

  lineItems          Json?

  subtotal           Decimal       @db.Decimal(12, 2)
  deliveryFee        Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount          Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount     Decimal       @default(0) @db.Decimal(12, 2)
  grandTotal         Decimal       @db.Decimal(12, 2)

  currency           String        @default("MMK") @db.VarChar(10)
  paymentMethod      String?        @db.VarChar(50)
  paymentGatewayRef  String?       @db.VarChar(255)
  paymentSlipUrl     String?       @db.VarChar(255)

  status             InvoiceStatus @default(UNPAID)

  pdfUrl             String?       @db.VarChar(255)
  pdfStatus          String        @default("PENDING") @db.VarChar(20)
  pdfError           String?       @db.Text
  pdfAttemptCount    Int           @default(0)
  pdfUpdatedAt       DateTime?

  verifiedBy         String?       @db.Char(36)
  verifiedAt         DateTime?

  rejectionReason    String?       @db.Text
  verificationNote   String?       @db.Text

  refundAmount       Decimal?      @db.Decimal(12, 2)
  refundMethod       String?       @db.VarChar(50)
  refundReason       String?       @db.Text

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // New normalized invoice items
  items              InvoiceItem[]
  idempotency        InvoiceIdempotency?
  receipt            Receipt?

  @@index([orderId])
  @@index([orderId, shopId])
  @@index([customerId])
  @@index([shopId, status])
  @@index([status])
  @@index([shopId], map: "invoices_shopId_idx")

  @@map("invoices")
}
model InvoiceItem {
  id                 String   @id @default(uuid()) @db.Char(36)

  invoiceId          String   @db.Char(36)

  // Reference to Order Service's order item.
  // This is NOT a local database foreign key.
  orderItemId        String   @db.VarChar(50)

  // Snapshot from Order/Product data
  productId          String   @db.Char(36)
  productName        String   @db.VarChar(255)
  productSku         String?  @db.VarChar(100)

  quantity           Int

  unitPrice          Decimal  @db.Decimal(12, 2)
  taxAmount          Decimal  @default(0) @db.Decimal(12, 2)
  discountAmount     Decimal  @default(0) @db.Decimal(12, 2)
  totalPrice         Decimal  @db.Decimal(12, 2)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Same order item can exist in multiple invoices,
  // but only once inside the same invoice.
  @@unique([invoiceId, orderItemId])

  @@index([orderItemId])
  @@index([productId])

  @@map("invoice_items")
}

model InvoiceOrderItemAllocation {
  id                String   @id @default(uuid()) @db.Char(36)
  orderItemId       String   @unique @db.VarChar(50)
  orderId           String   @db.Char(36)
  shopId            String   @db.Char(36)

  orderedQuantity   Int
  allocatedQuantity Int      @default(0)

  productId         String   @db.Char(36)
  productName       String   @db.VarChar(255)
  productSku        String?  @db.VarChar(100)
  unitPrice         Decimal  @db.Decimal(12, 2)
  currency          String   @db.VarChar(10)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([orderId])
  @@index([orderId, shopId])

  @@map("invoice_order_item_allocations")
}

model InvoiceIdempotency {
  id             String  @id @default(uuid()) @db.Char(36)
  idempotencyKey String  @unique @db.VarChar(255)
  requestHash    String  @db.Char(64)

  invoiceId      String  @unique @db.Char(36)
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("invoice_idempotency")
}

model InvoiceSequence {
  date       String   @id @db.Char(8)
  lastNumber Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("invoice_sequences")
}

model InvoiceOrderReference {
  id             Int      @id @default(autoincrement())
  orderId        String   @unique @db.Char(36)
  orderReference String   @unique @db.VarChar(50)
  createdAt      DateTime @default(now())

  @@map("invoice_order_references")
}

// One receipt per PAID invoice. Issued only after the invoice has actually
// transitioned to PAID (never for UNPAID / PENDING_VERIFICATION / REJECTED /
// VOID / REFUNDED). The UNIQUE constraint on invoiceId is the database-level
// guard against duplicate issuance under concurrent events.
model Receipt {
  id                String        @id @default(uuid()) @db.Char(36)
  receiptNumber     String        @unique @db.VarChar(50)

  invoiceId         String        @unique @db.Char(36)
  invoice           Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  invoiceNumber     String        @db.VarChar(50)

  orderId           String        @db.Char(36)
  orderReference    String?       @db.VarChar(32)

  shopId            String        @db.Char(36)
  shopName          String?       @db.VarChar(255)

  customerId        String        @db.Char(36)
  customerName      String?       @db.VarChar(255)
  customerEmail     String?       @db.VarChar(255)

  // Snapshot of the PAID invoice totals at issuance time.
  subtotal          Decimal       @db.Decimal(12, 2)
  deliveryFee       Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount         Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount    Decimal       @default(0) @db.Decimal(12, 2)
  grandTotal        Decimal       @db.Decimal(12, 2)

  currency          String        @default("MMK") @db.VarChar(10)
  paymentMethod     String?       @db.VarChar(50)
  paymentGatewayRef String?       @db.VarChar(255)

  status            ReceiptStatus @default(ISSUED)

  // Independent PDF lifecycle so a failed render can be retried without
  // ever creating a second receipt row.
  pdfUrl            String?       @db.VarChar(255)
  pdfStatus         String        @default("PENDING") @db.VarChar(20)
  pdfError          String?       @db.Text
  pdfAttemptCount   Int           @default(0)
  pdfUpdatedAt      DateTime?

  issuedAt          DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([orderId])
  @@index([shopId, status])
  @@map("receipts")
}

model ReceiptSequence {
  date       String   @id @db.Char(8)
  lastNumber Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("receipt_sequences")
}
