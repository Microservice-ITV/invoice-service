# syntax=docker/dockerfile:1

# ============================================================
# BUILD STAGE
# ============================================================
FROM node:22-bookworm-slim AS build

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        openssl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./

RUN --mount=type=cache,target=/root/.npm \
    npm ci

COPY tsconfig.json ./
COPY prisma ./prisma
COPY prisma.config.ts ./prisma.config.ts
COPY src ./src

RUN npx prisma generate
RUN npm run build

# Remove development-only packages.
# Prisma is a production dependency, so the CLI remains available
# for `npx prisma migrate deploy`.
RUN npm prune --omit=dev


# ============================================================
# PRODUCTION RUNTIME STAGE
# ============================================================
FROM node:22-bookworm-slim AS production

ENV NODE_ENV=production
ENV PORT=5006
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_CACHE_DIR=/home/app/.cache/puppeteer

WORKDIR /var/www/html/invoice-service

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        openssl \
        libglib2.0-0 \
        libnss3 \
        libnspr4 \
        libatk1.0-0 \
        libatk-bridge2.0-0 \
        libcups2 \
        libdrm2 \
        libdbus-1-3 \
        libxcb1 \
        libxkbcommon0 \
        libxcomposite1 \
        libxdamage1 \
        libxfixes3 \
        libxrandr2 \
        libgbm1 \
        libpango-1.0-0 \
        libcairo2 \
        libasound2 \
        fonts-liberation \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system app \
    && useradd --system --gid app --create-home app \
    && mkdir -p /home/app/.cache/puppeteer \
    && chown -R app:app /var/www/html/invoice-service /home/app

# Copy only the already-pruned production dependencies.
COPY --from=build --chown=app:app /app/node_modules ./node_modules

COPY --from=build --chown=app:app /app/dist ./dist
COPY --from=build --chown=app:app /app/prisma ./prisma
COPY --from=build --chown=app:app /app/prisma.config.ts ./prisma.config.ts
COPY --chown=app:app package.json package-lock.json ./

COPY --chown=app:app src/assets/fonts ./assets/fonts
COPY --chown=app:app src/assets/dni_website_qr.png ./src/assets/dni_website_qr.png

COPY --chown=app:app --chmod=755 \
    docker/node/docker-entrypoint.prod.sh \
    /usr/local/bin/docker-entrypoint.prod.sh

USER app

# Install Chrome as the non-root runtime user.
RUN PUPPETEER_SKIP_DOWNLOAD=false \
    npx puppeteer browsers install chrome

EXPOSE 5006

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.prod.sh"]

CMD ["node", "dist/server.js"]
