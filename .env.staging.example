# Compose / deploy naming
APP_CONTAINER_NAME=invoice-service-staging
PORT=5006

MYSQL_CONTAINER_NAME=invoice-db-staging
MYSQL_DATABASE=invoice_service_staging
MYSQL_USER=replace-with-database-user
MYSQL_PASSWORD=replace-with-database-password
MYSQL_ROOT_PASSWORD=replace-with-database-root-password
MYSQL_PORT=13310
MYSQL_VOLUME_NAME=invoice-mysql-staging-data

# Application
NODE_ENV=production
LOG_LEVEL=info
CORS_ORIGIN=https://dailyneeditems.com
FRONTEND_BASE_URL=https://dailyneeditems.com
SERVICE_API_KEY=replace-with-service-api-key
JWT_SECRET=replace-with-jwt-secret

# Database
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME

# RabbitMQ (external broker; staging uses dedicated queues)
RABBITMQ_URL=amqp://RABBITMQ_USER:RABBITMQ_PASSWORD@RABBITMQ_HOST:5672
RABBITMQ_EXCHANGE=order_events
RABBITMQ_PAYMENT_COMPLETED_KEY=payment.completed
RABBITMQ_PAYMENT_COLLECTED_KEY=payment.collected
RABBITMQ_ORDER_PAID_KEY=order.paid
RABBITMQ_PAYMENT_COMPLETED_QUEUE=invoice.payment.completed.staging
RABBITMQ_PAYMENT_COLLECTED_QUEUE=invoice.payment.collected.staging
RABBITMQ_ORDER_PAID_QUEUE=invoice.order.paid.staging

# Internal HTTP
AUTH_SERVICE_URL=http://authservice-nginx:80
AUTH_SERVICE_INTERNAL_KEY=replace-with-auth-service-key
ORDER_SERVICE_URL=http://orderservice-nginx
ORDER_SERVICE_API_KEY=replace-with-order-service-api-key
PRODUCT_SERVICE_URL=http://product-service:5001/api/v1

# Object storage (S3-compatible / DigitalOcean Spaces — no local MinIO)
MINIO_ENDPOINT=sgp1.digitaloceanspaces.com
MINIO_PORT=443
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
MINIO_BUCKET=dnistore
MINIO_PDF_BUCKET=dnistore
MINIO_USE_SSL=true
PUBLIC_BASE_URL=https://dnistore.sgp1.cdn.digitaloceanspaces.com

PDF_RETENTION_DAYS=7
PDF_RETENTION_INTERVAL_MS=86400000
PDF_RETENTION_BATCH_SIZE=100
PDF_RETENTION_CONCURRENCY=4
PDF_RETENTION_RETRY_LIMIT=3
PDF_RETENTION_LEASE_MS=300000
PDF_UPLOAD_TIMEOUT_MS=120000
PDF_RETENTION_HEAD_TIMEOUT_MS=30000
PDF_RETENTION_DELETE_TIMEOUT_MS=30000
PDF_RETENTION_DRY_RUN=true

NETWORK_NAME=itv-network
REDIS_URL=redis://REDIS_HOST:6379
