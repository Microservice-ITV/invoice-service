{
  "name": "invoice-service",
  "version": "1.0.0",
  "description": "Invoice service for E-commerce platform built with Express, TypeScript, Prisma, and RabbitMQ",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "seed:payment-completed": "node dist/scripts/seed-payment-completed.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "ecommerce",
    "invoice-service",
    "express",
    "typescript",
    "prisma",
    "rabbitmq"
  ],
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.0.0",
    "@types/archiver": "^8.0.0",
    "amqplib": "^0.10.4",
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "mariadb": "^3.5.4",
    "minio": "^8.0.1",
    "morgan": "^1.10.0",
    "puppeteer": "^24.0.0",
    "winston": "^3.11.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "prettier": "^3.1.1",
    "prisma": "^7.0.0",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
